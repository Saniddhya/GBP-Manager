
# Copy this file to `.env` and replace every placeholder with a real value.
# `.env` itself is git-ignored and must never be committed.

# MongoDB Atlas connection string.
MONGODB_URI=mongodb+srv://<db-user>:<db-password>@<cluster-host>/gbp-manager?retryWrites=true&w=majority

# JWT signing secret. Must be at least 32 random characters.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=replace-with-a-long-random-secret

# OpenRouter API key (https://openrouter.ai/keys).
OPENROUTER_API_KEY=sk-or-v1-replace-with-your-own-key

# Model used for generation. Falls back to google/gemini-2.0-flash-001 when empty.
OPENROUTER_MODEL=google/gemini-2.0-flash-001

# Public base URL of this deployment.
NEXT_PUBLIC_APP_URL=http://localhost:3000

